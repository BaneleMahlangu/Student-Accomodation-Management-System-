# Copy to .env and replace placeholders. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional in local development. Keep this outside MEDIA_ROOT; production must use persistent private storage.
# PRIVATE_DOCUMENT_ROOT=C:/secure/student-haven/documents
# PRIVATE_PROFILE_ROOT=C:/secure/student-haven/profile-images

# MySQL development database
DB_ENGINE=django.db.backends.mysql
DB_NAME=student_haven
DB_USER=student_haven_user
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sandbox can be enabled after entering PayFast sandbox merchant settings.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=

# SMTP settings used to deliver verification and account security codes.
# Gmail requires a Google app password here (not the account's normal password).
# Store the real password in .env or your hosting provider's secret store.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=studenthaven02@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Student Haven <studenthaven02@gmail.com>

# Set true only when HTTPS terminates at a correctly configured proxy.
SECURE_SSL_REDIRECT=false
